__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store
.ipynb_checkpoints/

# Trained model weights are too large for git
models/
*.bin
*.safetensors

# working notes, not part of the submitted project
notes/

# Raw documents belong to their publishers, so we share the download script and
# manifest instead of the files. Run scripts/download_sources.py to rebuild them.
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.csv

# Processed passages contain the publishers' text too, and are rebuilt by
# scripts/build_passages.py. The build report is small and is kept.
data/processed/*.jsonl

# Editor settings with paths to one machine
.vscode/

# Left over if a save to annotations ever fails partway
data/annotations/*.tmp
